  m_Script: {fileID: 11500000, guid: 5bb334db838f38c4eac438a1d5172a86, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteracaoNPC
  nomeDoNPC: Sr Jose Batista
  retrato: {fileID: 21300000, guid: 80ac3d712f3b1b84182f130f9e5b12f4, type: 3}
  falas:
  - "Impressionante! Em anos de vida, \xE9 a primeira vez que eu vejo uma manifesta\xE7\xE3o
    da Mata!\r\n"
  - " Mas bem, pelo visto voc\xEA tem uma miss\xE3o, fique a vontade para conhecer
    o vilarejo de Ubiracicaba! Bem\u2026 Sinto muito que voc\xEA n\xE3o vai conhecer
    o nosso humilde lar do jeito que ele realmente \xE9. Recentemente nossas terras
    t\xEAm enfrentado muitos problemas, muitos deles, vindo dos gigantes.\r\n"
  teclaInteracao: 101
  iconeInteragir: {fileID: 22001274}
